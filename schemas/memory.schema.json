{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmfraga/lm-pocket/schemas/memory.schema.json",
  "title": "LM-Pocket memory",
  "type": "object",
  "required": ["id", "content", "type", "status", "space", "source_type", "provenance", "created_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "content": { "type": "string", "minLength": 1 },
    "type": { "enum": ["fact", "preference", "event", "interpretation", "skill", "decision", "relationship", "goal"] },
    "status": { "enum": ["candidate", "durable", "archived", "rejected"] },
    "space": { "type": "string", "pattern": "^(personal|portable_professional|shared|public|work:[a-z0-9_-]+)$" },
    "sensitivity": { "enum": ["normal", "sensitive", "confidential"], "default": "normal" },
    "portable": { "type": "boolean", "default": false },
    "source_type": { "enum": ["user", "llm", "imported", "derived"] },
    "provenance": {
      "type": "object",
      "required": ["method", "recorded_at"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "client": { "type": "string" },
        "method": { "enum": ["mcp", "prompt_bridge", "manual", "derivation", "import"] },
        "conversation_ref": { "type": "string" },
        "external_ref": { "type": "string" },
        "recorded_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "derived_from": { "type": "array", "items": { "type": "string", "format": "uuid" }, "default": [] },
    "supersedes": { "type": "array", "items": { "type": "string", "format": "uuid" }, "default": [] },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] }
  },
  "additionalProperties": true
}
